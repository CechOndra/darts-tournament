# Copy to .env.local (never commit real keys) and fill in your values.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" / publishable key (safe for the browser; RLS + RPCs in supabase/schema.sql protect writes)
VITE_SUPABASE_ANON_KEY=

# Transport: "supabase" (default, GitHub Pages friendly) | "local" (LAN Socket.io relay in /server)
# If supabase is selected but the URL/key are missing, the app falls back to a same-browser loopback transport.
VITE_TRANSPORT_MODE=supabase

# Optional: LAN relay URL when VITE_TRANSPORT_MODE=local (defaults to http://<current-host>:3000)
VITE_LOCAL_SERVER_URL=

# Optional: tournament id shared by all devices (defaults to "main")
VITE_TOURNAMENT_ID=main
